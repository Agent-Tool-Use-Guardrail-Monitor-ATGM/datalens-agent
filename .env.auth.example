# Placeholder references only. Copy to ignored .env.auth when needed.
# Required by the FastAPI factory. Add these references to your ignored .env,
# or export them in the process environment; no implicit .env.auth loading.
APP_ENV=development
OIDC_ISSUER=http://localhost:8081/realms/datalens
OIDC_CLIENT_ID=agent-api
AUTH_PUBLIC_ORIGIN=http://localhost:8000
AUTH_CALLBACK_URL=http://localhost:8000/auth/callback
OIDC_CLIENT_SECRET_FILE=secrets/oidc-client.txt
AUTH_TOKEN_ENCRYPTION_KEYS_FILE=secrets/token-keys.json
OIDC_ALLOWED_ALGORITHMS=["RS256"]
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_HTTP_CONNECT_SECONDS=3
AUTH_HTTP_READ_SECONDS=5
AUTH_HTTP_POOL_SECONDS=1
AUTH_HTTP_DEADLINE_SECONDS=10
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_MAX_SECONDS=28800
AUTH_LOGIN_ATTEMPT_SECONDS=300
