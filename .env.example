# Copy to .env for local use and replace placeholders.
# Load explicitly with load_settings(env_file=".env"); relative paths use cwd.
# Process environment variables override this file. Never commit a real .env.
APP_ENV=development
SERVICE_NAME=agent-api
SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO

# Required. Agent storage only; never point this at Keycloak's identity database.
# URL-encode special characters in username/password. These are not real credentials.
DATABASE_URL=postgresql+psycopg://agent_local:REPLACE_ME@127.0.0.1:54329/agent_db

# Connections: 1–20; connect timeout: 1–60 seconds.
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=5
# Pool wait: 0.1–60 seconds; statement limit: 100–300000 milliseconds.
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=10000
# Probe budget: 0.05–10 seconds, strictly below each normal database timeout.
DB_HEALTH_TIMEOUT_SECONDS=2

# Model configuration: loaded explicitly by load_model_settings, not yet by the API.
# Store the real key only in ignored .env or an injected Azure secret.
LLM_PROFILE=groq_free
SERVICE_MODEL_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=1
# For LLM_PROFILE=azure_student, also set these server-owned names:
# LLM_AZURE_RESOURCE=your-resource
# LLM_AZURE_DEPLOYMENT=your-deployment
