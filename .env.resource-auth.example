# Bearer-mode API configuration. Load via process environment or Uvicorn --env-file.
APP_ENV=development
AUTH_HTTP_MODE=bearer
OIDC_ISSUER=http://localhost:8081/realms/datalens
OIDC_AUDIENCE=agent-api
OIDC_AUTHORIZED_PARTIES='["agent-web"]'
AUTH_CORS_ORIGINS='["http://localhost:5173"]'
# Hosted staging/production requires a canonical HTTPS realm issuer.
# AUTH_HTTP_CONNECT_SECONDS=3
# AUTH_HTTP_READ_SECONDS=5
# AUTH_HTTP_POOL_SECONDS=1
# AUTH_HTTP_DEADLINE_SECONDS=10
